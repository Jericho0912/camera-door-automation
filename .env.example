# --- Frigate / Fregata ---
FRIGATE_URL=http://127.0.0.1:5000
FRIGATE_CAMERA=door

# --- Poller ---
POLL_INTERVAL_MS=30000
POLL_OVERLAP_SECONDS=120

# --- Session windowing (tune during soak) ---
PRE_UNLOCK_LOOKBACK_SECONDS=20
SESSION_WINDOW_SECONDS=90
SESSION_EXTEND_SECONDS=30
SESSION_MAX_SECONDS=300
SESSION_CLOSE_GRACE_SECONDS=60

# --- Storage (Cloudflare R2 shown; drop S3_ENDPOINT for AWS) ---
S3_BUCKET=hackerhouse-entries
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLIP_URL_TTL_SECONDS=300
SNAPSHOT_URL_TTL_SECONDS=86400

# --- Notion ---
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=

# --- Slack (omit token to disable alerts) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#door-log

# --- Server ---
PORT=8787
LOCK_WEBHOOK_TOKEN=<generate: openssl rand -hex 32>
PUBLIC_BASE_URL=https://mac-mini.your-tailnet.ts.net

# --- Local state ---
DB_PATH=./data/entry-logger.db
GAP_THRESHOLD_SECONDS=600
