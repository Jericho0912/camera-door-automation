# Every variable reconciler.py reads. Anything not listed here is ignored.
# Copy to .env and edit. Delete lines you don't want — do NOT blank them:
# an empty value is not the same as an absent one and will crash or flip a default.

# --- Fregata (source of truth; read-only) ---
# Absolute paths. FREGATA_RECORDINGS_DIR must be the exact prefix of the values
# in the recordings.path column, or S3 keys land under a hashed external/ path.
#   sqlite3 -readonly "$FREGATA_DB_PATH" "SELECT path FROM recordings LIMIT 1;"
FREGATA_DB_PATH=~/Fregata/config/frigate.db
FREGATA_RECORDINGS_DIR=~/Fregata/media/recordings

# --- Local state (this program's own bookkeeping) ---
# Must be a FILE path, not a directory. Use an absolute path: the default is
# relative to the working directory, so running from elsewhere creates a second
# empty state DB and re-uploads everything.
STATE_DB_PATH=./reconciler-state.db

# --- Filters (exact string match; a mismatch returns 0 rows and exits 0) ---
# Get the real values from your database, don't guess:
#   sqlite3 -readonly "$FREGATA_DB_PATH" "SELECT DISTINCT camera, label FROM event;"
# CAMERA unset means NO camera filter — every camera on the NVR.
CAMERA=door_camera
LABEL=person

# --- Clip padding (seconds) ---
# Detector boundaries are not event boundaries. Without padding, short events
# produce unwatchable clips. Bare numbers only; "10s" is a startup crash.
PRE_ROLL_SECONDS=10
POST_ROLL_SECONDS=15

# --- S3 (AWS shown; for Cloudflare R2 set S3_ENDPOINT_URL and AWS_REGION=auto) ---
# Credentials are read by boto3 itself, so they must use the AWS_ names.
# The IAM policy needs PutObject, GetObject and AbortMultipartUpload on
# arn:aws:s3:::YOUR-BUCKET/<S3_PREFIX>/* — GetObject is required because every
# upload is followed by head_object.
S3_BUCKET=
S3_PREFIX=fregata
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# --- Notion (omit the token or the database id to disable) ---
# Token: Notion Developer portal -> Internal connections -> Configuration tab.
# Database id: the 32 hex characters in the database page URL, before the "?".
# The integration must ALSO be shared with the database: open it, ••• menu ->
# Connections -> Add connection. That step is not an API call and is easy to miss.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_VERSION=2026-03-11
# sub_label is a real person's name from face recognition. Off by default: with this false
# every page reads "Unrecognized". Turn it on only if you intend to publish names to Notion.
NOTION_INCLUDE_PERSON=false
# Give up on an event after this many failed Notion attempts, so one dead event cannot be
# retried on every poll forever ahead of the person actually at your door.
NOTION_MAX_ATTEMPTS=5

# --- Behaviour ---
# DRY_RUN accepts only 1/true/yes/on. Every other value, including a typo or an
# empty string, means LIVE. It fails toward uploading.
DRY_RUN=true
# The manifest embeds the whole event row, including sub_label — which is a real
# person's name when face recognition is on. Filter those fields before enabling.
UPLOAD_EVENT_MANIFEST=false
POLL_SECONDS=30
SETTLE_SECONDS=5
LOG_LEVEL=INFO

# --- Clip links (optional) ---
# A stable base URL written into Notion's Clip column. clipserver.py resolves it to a
# short-lived signed S3 URL when clicked, so the Notion link never expires -- and is
# useless to anyone not on your tailnet. Leave blank to omit the Clip column entirely.
# Set up with: tailscale serve --bg 8787
PUBLIC_BASE_URL=
CLIP_URL_TTL_SECONDS=300
CLIP_SERVER_PORT=8787
