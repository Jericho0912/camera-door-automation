<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>          <string>com.swarm.entry-logger</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOURUSER/entry-logger/venv/bin/python3</string>
    <string>/Users/YOURUSER/entry-logger/reconciler.py</string>
    <string>watch</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOURUSER/entry-logger</string>
  <key>RunAtLoad</key>      <true/>
  <key>KeepAlive</key>      <true/>
  <key>StandardOutPath</key><string>/Users/YOURUSER/entry-logger/logs/out.log</string>
  <key>StandardErrorPath</key><string>/Users/YOURUSER/entry-logger/logs/err.log</string>
</dict>
</plist>
